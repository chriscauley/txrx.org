# systemd unit for txrx.unrest.io. Canonical copy lives here; /etc/systemd/system/ holds a
# copy, not a symlink, so systemd can read it before /home is guaranteed mounted.
#   sudo cp /home/django/projects/txrx.org/deploy/txrx.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl restart txrx
#
# Reload workers without a restart:  touch /home/django/projects/txrx.org/server/uwsgi.ini   (or systemctl reload)

[Unit]
Description=txrx.unrest.io uwsgi
After=network-online.target postgresql.service postgresql@16-main.service
Wants=network-online.target

[Service]
Type=simple
User=django
Group=django
WorkingDirectory=/home/django/projects/txrx.org
ExecStartPre=/bin/mkdir -p /home/django/projects/txrx.org/logs
ExecStart=/home/django/projects/txrx.org/.venv/bin/uwsgi --ini /home/django/projects/txrx.org/server/uwsgi.ini
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
KillMode=mixed
TimeoutStopSec=30

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=read-only
ReadWritePaths=/home/django/projects/txrx.org
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
MemoryMax=400M

[Install]
WantedBy=multi-user.target
